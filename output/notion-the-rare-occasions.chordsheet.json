            { "id": "chord-v1-3-a", "symbol": "A", "anchor": { "graphemeOffset": 53 }, "voicingId": "voicing-a", "review": { "confidence": "high", "status": "confirmed" } },
            { "id": "chord-v1-3-faug", "symbol": "Faug", "anchor": { "graphemeOffset": 55 }, "voicingId": "voicing-faug", "review": { "confidence": "high", "status": "confirmed" } }
