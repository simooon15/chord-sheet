          ]
        },
        {
          "id": "line-v1-2",
          "type": "lyrics",
          "text": "But I don’t need the comfort of any lies",
          "chords": [
            { "id": "chord-v1-2-bm", "symbol": "Bm", "anchor": { "graphemeOffset": 12 }, "voicingId": "voicing-bm", "review": { "confidence": "high", "status": "confirmed" } },
