          ]
        },
        {
          "id": "line-v2-2",
          "type": "lyrics",
          "text": "That my end will be torture beneath the earth",
          "chords": [
            { "id": "chord-v2-2-bm", "symbol": "Bm", "anchor": { "graphemeOffset": 12 }, "voicingId": "voicing-bm", "review": { "confidence": "high", "status": "confirmed" } },
