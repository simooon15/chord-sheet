          ]
        },
        {
          "id": "line-v1-3",
          "type": "lyrics",
          "text": "For I have seen the ending and there is no ascending rise",
          "chords": [
            { "id": "chord-v1-3-bm", "symbol": "Bm", "anchor": { "graphemeOffset": 11 }, "voicingId": "voicing-bm", "review": { "confidence": "high", "status": "confirmed" } },
