          ]
        },
        {
          "id": "line-v2-3",
          "type": "lyrics",
          "text": "‘Cause I don’t see what they see when death is staring at me",
          "chords": [
            { "id": "chord-v2-3-bm", "symbol": "Bm", "anchor": { "graphemeOffset": 15 }, "voicingId": "voicing-bm", "review": { "confidence": "high", "status": "confirmed" } },
            { "id": "chord-v2-3-fsm", "symbol": "F#m", "anchor": { "graphemeOffset": 47 }, "voicingId": "voicing-fsm", "review": { "confidence": "high", "status": "confirmed" } }
          ]
        },
        {
          "id": "line-v2-4",
          "type": "lyrics",
          "text": "I see a window, a limit, to live it, or not at all ",
          "chords": [
            { "id": "chord-v2-4-bm6", "symbol": "Bm6", "anchor": { "graphemeOffset": 8 }, "voicingId": "voicing-bm6", "review": { "confidence": "high", "status": "confirmed" } },
