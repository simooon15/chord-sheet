    {
      "id": "section-verse-2",
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "id": "line-v2-1",
          "type": "lyrics",
          "text": "Oh, back when I was younger, was told by other youngsters",
          "chords": [
            { "id": "chord-v2-1-bm", "symbol": "Bm", "anchor": { "graphemeOffset": 14 }, "voicingId": "voicing-bm", "review": { "confidence": "high", "status": "confirmed" } },
