{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chordsheet.local/schema/chordsheet-v1.schema.json",
  "title": "ChordSheet package document",
  "description": "The structured chordsheet.json document stored at the root of a .chordsheet ZIP archive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "documentId",
    "metadata",
    "view",
    "sources",
    "sections",
    "voicings"
  ],
  "properties": {
    "format": {
      "const": "chordsheet"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "$ref": "#/$defs/dateTime"
    },
    "updatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "view": {
      "$ref": "#/$defs/view"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "voicings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/voicing"
      }
    },
    "rhythm": {
      "$ref": "#/$defs/rhythm"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "instrument"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "description": "A BCP 47 language tag when the language is known."
        },
        "difficulty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "baseWrittenKey": {
          "$ref": "#/$defs/keyName"
        },
        "instrument": {
          "$ref": "#/$defs/instrument"
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tuning"
      ],
      "properties": {
        "type": {
          "const": "guitar"
        },
        "tuning": {
          "type": "array",
          "description": "Open-string pitches ordered from the lowest-pitched string to the highest-pitched string.",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/pitch"
          }
        }
      }
    },
    "pitch": {
      "type": "string",
      "pattern": "^[A-G](?:#|b)?-?[0-9]+$"
    },
    "keyName": {
      "type": "string",
      "pattern": "^[A-G](?:#|b)?(?:m)?$"
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transposeSemitones",
        "capo",
        "fontScale",
        "chordDisplay"
      ],
      "properties": {
        "transposeSemitones": {
          "type": "integer",
          "minimum": -11,
          "maximum": 11,
          "description": "The non-destructive transposition applied when the score is rendered."
        },
        "capo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24,
          "description": "The manually selected capo fret. It does not rewrite stored chord symbols."
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 2
        },
        "chordDisplay": {
          "enum": [
            "name",
            "nameAndDiagram"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "embedded"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "copiedText",
            "image",
            "pdf"
          ]
        },
        "role": {
          "enum": [
            "content",
            "layout",
            "both"
          ]
        },
        "originalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "embedded": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^sources/(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "embedded": {
                "const": true
              }
            },
            "required": [
              "embedded"
            ]
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "embedded": {
                "const": false
              }
            },
            "required": [
              "embedded"
            ]
          },
          "then": {
            "not": {
              "required": [
                "path"
              ]
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "status"
      ],
      "properties": {
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "enum": [
            "unreviewed",
            "confirmed",
            "corrected"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "positionConflict",
              "contentConflict",
              "unclearSource",
              "inferred",
              "other"
            ]
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "low"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "required": [
              "reasons"
            ],
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "region": {
          "$ref": "#/$defs/region"
        }
      }
    },
    "region": {
      "type": "object",
      "description": "A source-space bounding box using normalized coordinates from 0 to 1.",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "intro",
            "verse",
            "preChorus",
            "chorus",
            "postChorus",
            "refrain",
            "bridge",
            "interlude",
            "instrumental",
            "solo",
            "breakdown",
            "outro",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "rhythmPatternId": {
          "$ref": "#/$defs/id"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/lyricLine"
              },
              {
                "$ref": "#/$defs/chordLine"
              },
              {
                "$ref": "#/$defs/annotationLine"
              }
            ]
          }
        }
      }
    },
    "lyricLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "chords"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "lyrics"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "chords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lyricChordEvent"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "chordLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "chords"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "chords"
        },
        "chords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chordOnlyEvent"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "annotationLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "annotation"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "lyricChordEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol",
        "anchor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "symbol": {
          "$ref": "#/$defs/chordSymbol"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "voicingId": {
          "$ref": "#/$defs/id"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "chordOnlyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "symbol"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "symbol": {
          "$ref": "#/$defs/chordSymbol"
        },
        "durationBeats": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voicingId": {
          "$ref": "#/$defs/id"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "chordSymbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The untransposed chord symbol preserved from the corrected base score."
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphemeOffset"
      ],
      "properties": {
        "graphemeOffset": {
          "type": "integer",
          "minimum": 0,
          "description": "The zero-based Unicode grapheme boundary before which the chord begins. The end boundary equals the lyric grapheme count."
        }
      }
    },
    "voicing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chordSymbol",
        "tuning",
        "frets",
        "baseFret",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "chordSymbol": {
          "$ref": "#/$defs/chordSymbol"
        },
        "tuning": {
          "type": "array",
          "description": "Open-string pitches ordered from the lowest-pitched string to the highest-pitched string.",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/pitch"
          }
        },
        "frets": {
          "type": "array",
          "description": "Absolute fret numbers ordered from the lowest-pitched string to the highest-pitched string. Null means muted and 0 means open.",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 36
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "fingers": {
          "type": "array",
          "description": "Finger numbers aligned with frets. Null means muted and 0 means open or unspecified.",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "baseFret": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36
        },
        "barres": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/barre"
          }
        },
        "verification": {
          "$ref": "#/$defs/voicingVerification"
        }
      }
    },
    "barre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromString",
        "toString",
        "fret"
      ],
      "properties": {
        "fromString": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "toString": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "fret": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36
        },
        "finger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "voicingVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "reference"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "method": {
          "enum": [
            "sourceDiagram",
            "licensedDataset",
            "manual"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "checkedAt": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "timeSignature": {
          "$ref": "#/$defs/timeSignature"
        },
        "tempoBpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 400
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rhythmPattern"
          }
        }
      }
    },
    "timeSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beatsPerMeasure",
        "beatUnit"
      ],
      "properties": {
        "beatsPerMeasure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "beatUnit": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      }
    },
    "rhythmPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "stepsPerMeasure",
        "events"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stepsPerMeasure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rhythmEvent"
          }
        }
      }
    },
    "rhythmEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "stroke"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0
        },
        "stroke": {
          "enum": [
            "down",
            "up",
            "chuck",
            "rest"
          ]
        },
        "accent": {
          "type": "boolean"
        }
      }
    }
  }
}
