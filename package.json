{
  "name": "chordsheet",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "validate:example": "node scripts/validate-chordsheet.mjs examples/anchor-check.chordsheet",
    "package:example": "node scripts/package-chordsheet.mjs examples/anchor-check/chordsheet.json --source sources/anchor-check.txt=examples/anchor-check/sources/anchor-check.txt --output examples/anchor-check.generated.chordsheet",
    "sync:skill-schema": "node scripts/sync-skill-schema.mjs",
    "audit:voicings": "node scripts/audit-guitar-voicings.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dexie": "^4.0.11",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
